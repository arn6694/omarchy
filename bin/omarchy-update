#!/bin/bash

# omarchy:summary=Update Omarchedora's Fedora system packages
# omarchy:args=[-y]
# omarchy:requires-sudo=true

set -euo pipefail
case "${1:-}" in
  -y) export OMARCHY_UPDATE_UNATTENDED=1 ;;
  "") ;;
  *) echo "Usage: omarchy update [-y]" >&2; exit 2 ;;
esac
if ! omarchy-update-lock held; then
  exec omarchy-update-lock run "$0" "$@"
fi
omarchy-update-system-pkgs
omarchy-hook post-update
echo "Fedora packages updated. Omarchedora source updates must be installed from the reviewed fork."
echo "Reboot after kernel, graphics driver, or compositor updates."
