#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

set -euo pipefail

(( $# > 0 )) || exit 0
resolved=$(omarchy-pkg-resolve "$@") || exit $?
mapfile -t packages <<< "$resolved"
set -- "${packages[@]}"

installed=()
declare -A installed_exact=()
declare -A selected=()

installed_names=$(rpm -qa --queryformat '%{NAME}\n')
while IFS= read -r package_name; do
  [[ -n $package_name ]] || continue
  installed_exact[$package_name]=1
done <<< "$installed_names"

for pkg in "$@"; do
  if [[ -n ${installed_exact[$pkg]:-} && -z ${selected[$pkg]:-} ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  if (( EUID == 0 )); then
    dnf -y remove -- "${installed[@]}"
  else
    sudo dnf -y remove -- "${installed[@]}"
  fi
fi
