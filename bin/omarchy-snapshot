#!/bin/bash
# omarchy:summary=Create Snapper snapshots using an existing Fedora configuration

set -euo pipefail
command -v snapper >/dev/null || { echo 'Snapper is not installed or configured on this Fedora system.' >&2; exit 127; }
case "${1:-}" in
  create)
    configs=$(sudo snapper --csvout list-configs)
    mapfile -t names < <(awk -F, 'NR>1 {print $1}' <<< "$configs")
    (( ${#names[@]} )) || { echo 'Configure Snapper for your Fedora filesystem before creating snapshots.' >&2; exit 1; }
    for name in "${names[@]}"; do
      sudo snapper -c "$name" create -d 'Omarchedora manual snapshot'
    done
    echo 'Snapshots created. Boot-menu recovery is not configured by Omarchedora.'
    ;;
  restore)
    echo 'Automatic bootable rollback is omitted for Fedora. Review your filesystem and Snapper recovery procedure.' >&2
    exit 69
    ;;
  *) echo 'Usage: omarchy snapshot <create|restore>' >&2; exit 2 ;;
esac
