#!/bin/bash
# omarchy:summary=Enroll a fingerprint using Fedora authselect policy

set -euo pipefail
omarchy-pkg-add fprintd fprintd-pam libfprint usbutils authselect
fprintd-enroll "$USER"
fprintd-verify "$USER"
sudo authselect check
sudo authselect enable-feature with-fingerprint
sudo omarchy-apply-lock
